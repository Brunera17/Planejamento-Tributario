# Backend
DATABASE_URL=postgresql+psycopg://planejador:planejador@localhost:5432/planejador
JWT_SECRET=gere-um-segredo-com-pelo-menos-32-caracteres
# durante a troca do segredo, o antigo vai aqui por até 15 min (tokens já emitidos continuam válidos)
JWT_SECRET_ANTERIOR=
# sessão: access de 15 min, sessão absoluta de 12 h (renovar não estende)
ACCESS_TTL_MIN=15
SESSAO_ABSOLUTA_H=12
# false só se a tela for servida em HTTP fora de localhost
COOKIE_SECURE=true
# atrás do proxy do Render: true; PROXIES_CONFIAVEIS = CIDRs de saltos a pular (ex.: proxy da Vercel)
IP_POR_X_FORWARDED_FOR=false
PROXIES_CONFIAVEIS=
ORIGEM_PUBLICA=
# obrigatório em produção (ex.: redis://localhost:6379/0); vazio no desenvolvimento usa Redis em memória
# (fakeredis, de requirements-dev.txt — só para um processo; sessões somem ao reiniciar)
REDIS_URL=
UPLOAD_DIR=./uploads
# arquivos cifrados (AES-256-GCM). Obrigatória em produção: `python -m app.services.cripto --gerar-chave`.
# Perder a chave = perder os documentos: guarde uma cópia fora do servidor. Vazia no SQLite = chave de desenvolvimento.
CHAVE_ARQUIVOS=
CHAVE_ARQUIVOS_ID=k1
# na rotação: "id:base64" das chaves anteriores, até rodar --recifrar-chaves
CHAVES_ARQUIVOS_ANTIGAS=
# true só na transição: depois de `python -m app.services.cripto --cifrar-existentes`, false
ACEITAR_ARQUIVO_SEM_CIFRA=true
CORS_ORIGINS=http://localhost:5173

# Frontend
# vazio = /api relativo (proxy do Vite no dev; rewrite da Vercel em produção)
VITE_API_URL=

# Relatórios PDF
ESCRITORIO_NOME=Planejador Tributário
